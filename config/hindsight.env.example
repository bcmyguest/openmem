# Copy to ~/.config/hindsight/hindsight.env and edit. The real file lives outside the repository;
# compose.yaml reads it from there (or $HINDSIGHT_ENV_FILE).
# Docker reaches host services at host.docker.internal.
# All LLM calls go to the LiteLLM proxy (compose service `litellm`). Models are chosen in config/litellm.*.yaml.
# scripts/setup.sh --migrate-env writes HINDSIGHT_API_LLM_API_KEY from ~/.config/hindsight/litellm.env.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=http://litellm:4000/v1
HINDSIGHT_API_LLM_MODEL=memory-reflect
HINDSIGHT_API_RETAIN_LLM_MODEL=memory-retain
HINDSIGHT_API_REFLECT_LLM_MODEL=memory-reflect
HINDSIGHT_API_CONSOLIDATION_LLM_MODEL=memory-consolidate
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_MODEL=memory-reflect
HINDSIGHT_API_LLM_API_KEY=replace-me
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_WORKER_ID=hindsight-personal
HINDSIGHT_API_SKIP_LLM_VERIFICATION=true
HINDSIGHT_API_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_LLM_TIMEOUT=300
HINDSIGHT_API_LLM_MAX_RETRIES=1

# verbatim: store chunk text as-is; LLM only extracts entities/time/location (faster than concise).
HINDSIGHT_API_RETAIN_EXTRACTION_MODE=verbatim
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=16384
HINDSIGHT_API_REFLECT_MAX_COMPLETION_TOKENS=2048
HINDSIGHT_API_CONSOLIDATION_MAX_COMPLETION_TOKENS=2048
