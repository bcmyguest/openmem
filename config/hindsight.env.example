# Copy to ~/.config/hindsight/hindsight.env and edit. The real file lives outside the repository;
# compose.yaml reads it from there (or $HINDSIGHT_ENV_FILE).
# Docker reaches host services at host.docker.internal.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:13305/v1
HINDSIGHT_API_LLM_MODEL=Gemma-4-E2B-it-GGUF
HINDSIGHT_API_LLM_API_KEY=replace-me
HINDSIGHT_API_RETAIN_LLM_REASONING_EFFORT=low
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_WORKER_ID=hindsight-personal
HINDSIGHT_API_SKIP_LLM_VERIFICATION=true
HINDSIGHT_API_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_LLM_TIMEOUT=300
HINDSIGHT_API_LLM_MAX_RETRIES=1

# Ollama alternative: replace the LLM lines above with these.
# Host Ollama must listen on all interfaces so the container can reach it. Set
# OLLAMA_HOST=0.0.0.0:11434 in the Ollama service's environment, then restart Ollama.
# HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:11434/v1
# HINDSIGHT_API_LLM_MODEL=qwen3.5:4b
# HINDSIGHT_API_LLM_API_KEY=replace-me
