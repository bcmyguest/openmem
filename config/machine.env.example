# Per-machine defaults for ./setup (copy to config/machine.env — gitignored).
#
#   cp config/machine.env.example config/machine.env
#   $EDITOR config/machine.env
#   ./setup
#
# Values seed the wizard before ~/.config/hindsight/wizard.conf exists, and with
# ./setup --yes. After the first successful run, wizard.conf is the source of truth;
# edit machine.env when you want to change defaults for the next --yes refresh.

# Probe URL for lemond on this host (not the docker-internal URL).
LEMOND_BASE=http://127.0.0.1:13305

# Default backend choice with --yes (lemond | ollama | custom). Interactive ./setup
# still asks unless you pass --yes.
# PM_BACKEND=lemond

# Default retain/consolidate model id (backend-specific). Blank uses shipped defaults.
# PM_DEFAULT_MODEL=Gemma-4-E2B-it-GGUF

# Separate reflect model, or leave empty for the shipped memory-reflect route (E4B on lemond).
# Use a stronger or remote model when reflect fails (Meridian, OpenAI-compatible host).
# PM_REFLECT_MODEL=

# Custom OpenAI-compatible backend (work laptop + Meridian, hosted API, etc.)
# CUSTOM_DEFAULT_BASE=http://host.docker.internal:3456/v1
# CUSTOM_DEFAULT_MODEL=claude-sonnet-4
