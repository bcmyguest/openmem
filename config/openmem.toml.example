# Mise-like declarative config for the openmem meta wizard.
#
#   mkdir -p ~/.config/personal-memory
#   cp config/openmem.toml.example ~/.config/personal-memory/config.toml
#   $EDITOR ~/.config/personal-memory/config.toml
#   ./setup --yes
#
# Precedence (highest wins): CLI flags → environment variables →
#   ~/.config/personal-memory/config.toml → ./personal-memory.toml (stack root) →
#   ~/.config/hindsight/wizard.conf (last configure run).
#
# Provider-native settings (mem0 cloud, Hindsight product UI, etc.) stay in those tools;
# this file only describes how this machine runs the shared stack.

[memory]
provider = "hindsight"

[stack]
project = "openmem"
api_port = 8888
control_plane_port = 9999

# Default wizard action when ./setup runs non-interactively without --up/--down
[wizard]
action = "configure" # configure | up | down

# LLM routing for Hindsight (LiteLLM → lemond/Ollama/custom/Meridian). Not lemond's own config.
[model]
backend = "lemond" # lemond | ollama | custom | meridian (Claude subscription, docs/meridian-litellm.md)
retain = "Gemma-4-E2B-it-GGUF"
reflect = ""       # empty = shipped memory-reflect route
api_base = ""      # custom backend only

[model.lemond]
host = "http://127.0.0.1:13305"

[model.ollama]
host = "http://127.0.0.1:11434"

# meridian backend only: Meridian's URL as seen from this host. The wizard does not run Meridian.
# [model.meridian]
# host = "http://127.0.0.1:3456"

# Coding-agent wiring, written by `install-coding-agent`.
# integration: "openmem" = OpenMem session hooks; "provider" = the provider's own plugin
# (Hindsight: @vectorize-io/hindsight-coding-agents). The two hook sets are exclusive.
[agents]
integration = "openmem"

# Local LiteLLM context proxy (`install-coding-agent --context-proxy`). When enabled,
# Claude Code's ANTHROPIC_BASE_URL points at http://127.0.0.1:<port>.
# trim_at_tokens / compress_over_tokens (and [compaction] max_chars) reach the proxy
# container through the stack .env (written by ./setup and install-coding-agent) and the
# OpenCode 2 plugin; the env vars CONTEXT_TRIM_AT_TOKENS, CONTEXT_COMPRESS_OVER_TOKENS,
# CONTEXT_STANDING_INSTRUCTION, CONTEXT_CHARS_PER_TOKEN and CONTEXT_COMPACTION_MAX_CHARS override them.
[context_proxy]
enabled = false
port = 4100
trim_at_tokens = 120000     # trim a session once its request exceeds this many tokens
compress_over_tokens = 4000 # compress tool results larger than this
standing_instruction = true # constant system-prompt note telling the agent to search trimmed turns
chars_per_token = 2.5       # token estimate before a session reports usage; reported usage calibrates it after

# Session databases (sessions/<sid>.db, docs/context-store.md): every message of a trimmed session.
# ttl_days: delete sessions idle longer than this, checked at proxy / MCP start at most once a day (0 = keep).
# embedding_model: OpenAI-compatible embedding model for hybrid smart_compact_search; empty = vectors off.
# The stack ships no embedding route; e.g. `ollama pull nomic-embed-text` and set it here.
# embedding_url: that endpoint as this host sees it (the proxy container uses CONTEXT_PROXY_EMBEDDING_URL).
[context_store]
ttl_days = 30
embedding_model = ""
embedding_url = "http://127.0.0.1:11434/v1"

# native (OpenCode 2 only): when OpenCode compacts a session, OpenMem's plugin supplies the
# smart_compact_search pointer + recall as the summary instead of a model call.
# false leaves compaction to OpenCode.
# max_chars: cap on the recall text placed after a trim or compaction pointer.
[compaction]
native = true
max_chars = 12000

# Optional indexer defaults (wizard may still prompt interactively)
# [[index.roots]]
# path = "~"
# depth = 3

# Mise-style named tasks (run via ./pm <name>)
[tasks.configure]
description = "Secrets, index sources, build images, compose up"

[tasks.up]
description = "Start stack using existing config"

[tasks.down]
description = "docker compose down for this project"

[tasks.doctor]
description = "Validate memory setup on this machine"

# Provider-native options live in their own tables, not under [model].
# mem0 is URL-only: point at a self-hosted REST server (not https://api.mem0.ai).
# [memory.mem0]
# api_url = "http://127.0.0.1:18888"
# env_file = "~/.config/personal-memory/mem0.env"
