{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/../hook-runner.mjs\" claude-code sessionStart",
          "timeout": 30
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/../hook-runner.mjs\" claude-code prompt",
          "timeout": 30
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/../hook-runner.mjs\" claude-code stop",
          "timeout": 60
        }
      ]
    }
  ]
}
