{
  "name": "personal-memory",
  "version": "0.4.0",
  "description": "Choose your coding-agent memory backend (Hindsight, mem0, Cognee): one wizard, shared indexer, switch providers without vendor lock-in.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "B Guest",
  "homepage": "https://bcmyguest.github.io/personal-memory/",
  "bugs": {
    "url": "https://github.com/bcmyguest/personal-memory/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcmyguest/personal-memory.git"
  },
  "keywords": [
    "memory",
    "ai-memory",
    "hindsight",
    "docker-compose",
    "setup-wizard",
    "coding-agent"
  ],
  "bin": {
    "personal-memory": "cli/personal-memory.mjs",
    "personal-memory-setup": "wizard/bin/setup.mjs",
    "personal-memory-notebooklm-mcp": "cli/notebooklm-mcp.mjs",
    "personal-memory-cognee-mcp": "cli/cognee-mcp.mjs",
    "personal-memory-install-mcp": "cli/install-memory-mcp.mjs",
    "personal-memory-install-coding-agent": "cli/install-coding-agent.mjs",
    "personal-memory-mcp": "cli/personal-memory-mcp.mjs",
    "personal-memory-switch-provider": "cli/switch-memory-provider.mjs"
  },
  "files": [
    "cli/",
    "wizard/bin/",
    "wizard/lib/",
    "providers/",
    "compose.yaml",
    "compose.bench.yaml",
    "indexer/",
    "bin/",
    "sync/",
    "config/*.example",
    "config/index.yml",
    "config/notebooklm.yml",
    "config/litellm.*.yaml",
    "config/coding-agent.json",
    "scripts/*.mjs",
    "scripts/*.sh",
    "README.md",
    "LICENSE",
    "docs/",
    "!docs/ROADMAP*",
    "!docs/WAVE*",
    "!**/__pycache__",
    "!**/*.pyc",
    "!**/tests",
    "!**/.pytest_cache"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "node wizard/bin/setup.mjs",
    "pm": "node wizard/bin/pm.mjs",
    "personal-memory": "node cli/personal-memory.mjs",
    "install-mcp": "node cli/install-memory-mcp.mjs",
    "install-coding-agent": "node cli/install-coding-agent.mjs",
    "feed-sync": "node cli/feed-sync.mjs",
    "switch-provider": "node cli/switch-memory-provider.mjs",
    "test": "for t in scripts/tests/test_*.mjs; do node \"$t\" || exit 1; done && bash scripts/tests/test_wizard.sh",
    "test:indexer": "cd indexer && python3 -m pytest -q",
    "test:unit": "node scripts/tests/test_cli_package.mjs --unit",
    "pack:check": "node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@iarna/toml": "^2.2.5"
  }
}
