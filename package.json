{
  "name": "openmem",
  "version": "0.6.3",
  "description": "OpenMem \u2014 memory interface for coding agents: pluggable providers (Hindsight, mem0, Cognee, \u2026), shared wizard/indexer, multi-format import/export (PMM and more).",
  "type": "module",
  "license": "Apache-2.0",
  "author": "B Guest",
  "homepage": "https://bcmyguest.github.io/openmem/",
  "bugs": {
    "url": "https://github.com/bcmyguest/openmem/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcmyguest/openmem.git"
  },
  "mcpName": "io.github.bcmyguest/openmem",
  "keywords": [
    "openmem",
    "memory",
    "ai-memory",
    "hindsight",
    "mem0",
    "cognee",
    "mcp",
    "mcp-server",
    "docker-compose",
    "setup-wizard",
    "coding-agent",
    "pmm"
  ],
  "bin": {
    "openmem": "cli/openmem.mjs",
    "openmem-setup": "wizard/bin/setup.mjs",
    "openmem-mcp": "cli/openmem-mcp.mjs",
    "openmem-install-mcp": "cli/install-memory-mcp.mjs",
    "openmem-install-coding-agent": "cli/install-coding-agent.mjs",
    "openmem-switch-provider": "cli/switch-memory-provider.mjs",
    "openmem-notebooklm-mcp": "cli/notebooklm-mcp.mjs",
    "openmem-cognee-mcp": "cli/cognee-mcp.mjs"
  },
  "files": [
    "cli/",
    "skills/",
    "wizard/bin/",
    "wizard/lib/",
    "providers/",
    "compose.yaml",
    "compose.bench.yaml",
    "indexer/",
    "bin/",
    "sync/",
    "config/*.example",
    "config/index.yml",
    "config/notebooklm.yml",
    "config/litellm.*.yaml",
    "config/coding-agent.json",
    "scripts/*.mjs",
    "scripts/*.sh",
    "README.md",
    "LICENSE",
    "glama.json",
    "server.json",
    "docs/",
    "!docs/ROADMAP*",
    "!docs/WAVE*",
    "!docs/ANNOUNCEMENT*",
    "!docs/PUBLISH*",
    "!**/__pycache__",
    "!**/*.pyc",
    "!**/tests",
    "!**/.pytest_cache"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "node wizard/bin/setup.mjs",
    "pm": "node wizard/bin/pm.mjs",
    "openmem": "node cli/openmem.mjs",
    "install-mcp": "node cli/install-memory-mcp.mjs",
    "install-coding-agent": "node cli/install-coding-agent.mjs",
    "feed-sync": "node cli/feed-sync.mjs",
    "switch-provider": "node cli/switch-memory-provider.mjs",
    "test": "for t in scripts/tests/test_*.mjs; do node \"$t\" || exit 1; done && bash scripts/tests/test_wizard.sh",
    "test:indexer": "cd indexer && python3 -m pytest -q",
    "test:unit": "node scripts/tests/test_cli_package.mjs --unit",
    "pack:check": "node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@iarna/toml": "^2.2.5",
    "yaml": "^2.9.1"
  }
}
