{
  "id": "hindsight",
  "label": "Hindsight",
  "status": "supported",
  "compose": {
    "services": ["litellm", "hindsight", "indexer"],
    "healthService": "hindsight",
    "healthPath": "/health",
    "hostPortEnv": "HINDSIGHT_PORT",
    "defaultHostPort": 8888,
    "logServices": ["hindsight", "litellm"],
    "profile": "hindsight",
    "files": []
  },
  "indexer": {
    "apiUrlEnv": "HINDSIGHT_URL",
    "sink": "hindsight",
    "sinkDriver": "hindsight-rest-v1"
  },
  "codingAgent": {
    "pluginPackage": "@vectorize-io/hindsight-coding-agents",
    "configTemplate": "config/coding-agent.json"
  },
  "settings": {
    "nativeDocs": "https://github.com/vectorize-io/hindsight",
    "nativeConfigPaths": [
      "~/.config/hindsight/hindsight.env",
      "~/.config/hindsight/litellm.yaml",
      "config/litellm.lemond.yaml"
    ],
    "wizardOwns": [
      "compose stack and ports",
      "index.yml sources",
      "LiteLLM proxy wiring for Hindsight LLM aliases",
      "coding-agent.json symlink"
    ]
  },
  "wizardHooks": {
    "module": "wizard.mjs",
    "delegates": {}
  },
  "wizard": {
    "smokeBank": "wizard-smoke",
    "retainMethod": "POST",
    "retainPath": "/v1/default/banks/{bank}/memories",
    "retainBody": "{\"items\":[{\"content\":\"Wizard smoke test: the project codename is heron.\"}],\"async\":false}",
    "recallMethod": "POST",
    "recallPath": "/v1/default/banks/{bank}/memories/recall",
    "recallBody": "{\"query\":\"What is the project codename?\"}",
    "recallMustMatch": "heron",
    "smokeRetainTimeoutSec": 90,
    "smokeRecallTimeoutSec": 60,
    "retainHint": "Open {controlPlane} (ops queue) and {api}/docs. LLM is shared (one retain at a time): cancel other banks' pending retains, or stop coding-agent/NotebookLM sync while smoking. If Ollama shows size_vram=0 it is on CPU — use GPU/ROCm or a faster model in ~/.config/hindsight/litellm.yaml, then: {compose} up -d litellm. Logs: {logs}",
    "recallHint": "Open {controlPlane}; check memory-retain/reflect routes ({compose} logs litellm). Logs: {logs}",
    "deleteMethod": "DELETE",
    "deletePath": "/v1/default/banks/{bank}"
  }
}
