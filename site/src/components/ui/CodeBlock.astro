---
// A command block with a copy button. The button is inert until the inline
// script in Landing.astro runs; without JavaScript the text is still selectable.
interface Props {
  code: string;
  label: string;
  copy?: boolean;
}
const { code, label, copy = true } = Astro.props;
---
<div class="group relative">
  <pre class="overflow-x-auto rounded-lg border border-line bg-code p-4 pr-20 text-sm leading-relaxed" tabindex="0" role="group" aria-label={label}><code>{code}</code></pre>
  {copy && (
    <button
      type="button"
      data-copy={code}
      class="copy-btn absolute right-2 top-2 rounded-md border border-line bg-panel px-2.5 py-1 text-xs font-semibold text-ink hover:bg-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      aria-label={`Copy: ${label}`}
    >
      Copy
    </button>
  )}
</div>
