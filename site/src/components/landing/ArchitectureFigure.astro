---
// Hero figure: how data moves on one machine. Sources are indexed into the
// active provider; coding agents read and write memory through the provider's
// own plugin. The provider column is built from the manifests, so its status
// badges can never disagree with the provider table below.
import { providers, STATUS_LABEL } from '../../lib/content';
import { withBase } from '../../lib/url';
import { site } from '../../site.config.mjs';
import Badge from '../ui/Badge.astro';

const sources = [
  'Git repositories',
  'Obsidian vaults',
  'Notes · papers · bookmarks',
  'Feed cache (RSS / OpenAlex)',
];
const indexer = ['Tree-sitter code outlines', 'Poll repos · watch folders', 'Sink → active provider API'];
const bridge = [
  'openmem MCP (memory_*)',
  'Session hooks (all providers)',
  'Provider MCP (mem0/Cognee, optional)',
  'NotebookLM MCP (optional)',
];
const agents = ['Claude Code', 'Codex', 'OpenCode'];
const agentPackage = providers.find((p) => p.status === 'supported' && p.codingAgentPackage)?.codingAgentPackage;
---
<figure class="arch not-prose" aria-labelledby="arch-caption">
  <div class="arch-surface overflow-hidden rounded-xl border border-line">
    <div class="arch-flow">
      <div class="arch-col" role="group" aria-labelledby="arch-h-src">
        <p id="arch-h-src" class="arch-label">Sources</p>
        <ul class="arch-list">
          {sources.map((s) => <li class="arch-node">{s}</li>)}
        </ul>
      </div>

      <svg class="arch-arrow" viewBox="0 0 40 16" aria-hidden="true" focusable="false"><path class="flow" d="M2 8H32" /><path class="tip" d="M30 3l8 5-8 5z" /></svg>

      <div class="arch-col" role="group" aria-labelledby="arch-h-idx">
        <p id="arch-h-idx" class="arch-label">Shared indexer</p>
        <ul class="arch-list">
          {indexer.map((s) => <li class="arch-node">{s}</li>)}
        </ul>
      </div>

      <svg class="arch-arrow" viewBox="0 0 40 16" aria-hidden="true" focusable="false"><path class="flow" d="M2 8H32" /><path class="tip" d="M30 3l8 5-8 5z" /></svg>

      <div class="arch-col" role="group" aria-labelledby="arch-h-prov">
        <p id="arch-h-prov" class="arch-label">Memory provider</p>
        <ul class="arch-list">
          {providers.map((p) => (
            <li class={`arch-node arch-provider is-${p.status}`}>
              <span>{p.label}</span>
              <Badge variant={p.status}>{STATUS_LABEL[p.status]}</Badge>
            </li>
          ))}
        </ul>
      </div>

      <svg class="arch-arrow arch-arrow-bidir" viewBox="0 0 40 16" aria-hidden="true" focusable="false"><path class="flow" d="M2 8H32" /><path class="tip" d="M30 3l8 5-8 5z" /><path class="tip-l" d="M10 3L2 8l8 5z" /></svg>

      <div class="arch-col" role="group" aria-labelledby="arch-h-bridge">
        <p id="arch-h-bridge" class="arch-label">MCP &amp; plugins (host)</p>
        <ul class="arch-list">
          {bridge.map((s) => <li class="arch-node">{s}</li>)}
        </ul>
      </div>

      <svg class="arch-arrow" viewBox="0 0 40 16" aria-hidden="true" focusable="false"><path class="flow" d="M8 8H32" /><path class="tip-l" d="M10 3L2 8l8 5z" /><path class="tip" d="M30 3l8 5-8 5z" /></svg>

      <div class="arch-col" role="group" aria-labelledby="arch-h-agents">
        <p id="arch-h-agents" class="arch-label">Coding agents</p>
        <ul class="arch-list">
          {agents.map((s) => <li class="arch-node">{s}</li>)}
        </ul>
      </div>
    </div>

    <div class="arch-title" aria-hidden="true">
      <span>{site.name.toUpperCase()}</span><span>DATA FLOW</span>
    </div>
  </div>
  <figcaption id="arch-caption" class="mt-3 text-xs leading-relaxed text-muted">
    <strong>Indexing:</strong> repos, vaults, markdown trees, and feed cache → shared indexer → one active provider API (badges from manifests).
    <strong>Agents:</strong> unified <code>memory_*</code> MCP and session hooks on the host; optional provider-native MCP and NotebookLM MCP.
    LiteLLM is optional on Hindsight stacks (not shown). Optional upstream Hindsight plugin{agentPackage && (<Fragment> (<code>{agentPackage}</code>)</Fragment>)} replaces the session hooks via <code>--provider-plugin</code>.
    <a href={withBase('docs/architecture/')}>Architecture</a>.
  </figcaption>
</figure>

<style>
  .arch-surface {
    position: relative;
    background-color: var(--c-map-canvas);
    background-image:
      linear-gradient(var(--c-map-dot) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-map-dot) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: -1px -1px;
  }
  .arch-flow {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    padding: 1.25rem 1rem 1rem;
  }
  @media (min-width: 64rem) {
    .arch-flow {
      grid-template-columns: 1fr 2rem 1fr 2rem 1.05fr 2rem 1fr 2rem 0.95fr;
      align-items: center;
      gap: 0;
      padding: 1.75rem 1rem 1.25rem;
    }
  }
  .arch-col {
    border: 1px solid var(--c-line);
    background: var(--c-panel);
    border-radius: 0.75rem;
    padding: 0.875rem;
    height: 100%;
  }
  .arch-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin: 0 0 0.625rem;
  }
  .arch-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .arch-node {
    border: 1px solid var(--c-line);
    background: var(--c-panel-raised);
    border-radius: 0.5rem;
    padding: 0.5rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .arch-provider {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.375rem;
  }
  .arch-provider.is-supported {
    border-color: var(--c-brand);
    background: var(--c-brand-soft);
  }
  .arch-provider.is-experimental {
    border-style: dashed;
    border-color: var(--c-inferred);
  }
  .arch-provider.is-planned {
    border-style: dashed;
    background: transparent;
    color: var(--c-muted);
  }
  .arch-arrow {
    width: 100%;
    height: 1.25rem;
    justify-self: center;
    transform: rotate(90deg);
    max-width: 2.5rem;
    margin: 0.625rem auto;
  }
  @media (min-width: 64rem) {
    .arch-arrow {
      transform: none;
      margin: 0;
    }
  }
  .arch-arrow .flow {
    stroke: var(--c-brand);
    stroke-width: 2;
    fill: none;
    stroke-dasharray: 4 4;
    animation: arch-dash 1.2s linear infinite;
  }
  .arch-arrow .tip,
  .arch-arrow .tip-l {
    fill: var(--c-brand);
  }
  .arch-arrow-bidir .flow {
    stroke-dasharray: none;
  }
  @keyframes arch-dash {
    to {
      stroke-dashoffset: -8;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .arch-arrow .flow {
      animation: none;
    }
  }
  .arch-title {
    display: none;
  }
  @media (min-width: 64rem) {
    .arch-title {
      position: absolute;
      right: 1.5rem;
      bottom: 0.875rem;
      display: grid;
      grid-template-columns: auto auto;
      border: 1px solid var(--c-line);
      background: var(--c-panel);
      border-radius: 0.25rem;
      font-size: 0.625rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--c-muted);
    }
    .arch-title span {
      padding: 0.25rem 0.5rem;
    }
    .arch-title span + span {
      border-left: 1px solid var(--c-line);
    }
  }
  code {
    font-size: 0.85em;
  }
</style>
