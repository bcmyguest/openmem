---
// Hero figure: the memory overview diagram, drawn by overview-diagrams.mjs with the site's colour
// tokens. Wide layout from lg up; the narrow layout below that. Docs use the same source as static SVGs.
import { withBase } from '../../lib/url';
import { CSS_PALETTE, memoryDiagram } from './overview-diagrams.mjs';

const wide = memoryDiagram(CSS_PALETTE, 'wide', 'hero-mem-w');
const narrow = memoryDiagram(CSS_PALETTE, 'narrow', 'hero-mem-n');
---
<figure class="ov not-prose" aria-labelledby="ov-caption">
  <div class="ov-wide">
    <div class="ov-card" set:html={wide} />
  </div>
  <div class="ov-narrow">
    <div class="ov-card" set:html={narrow} />
  </div>
  <figcaption id="ov-caption" class="mt-3 text-sm leading-relaxed text-muted">
    OpenMem parts are tinted. The indexer feeds one provider; agents read and write it through OpenMem's <code>memory_*</code> tools and session hooks.{' '}
    <a class="font-semibold text-source underline underline-offset-4" href={withBase('docs/architecture/')}>Full architecture</a> ·
    <a class="font-semibold text-source underline underline-offset-4" href={withBase('docs/provider-status/')}>Provider status</a>
  </figcaption>
</figure>

<style>
  .ov-wide {
    display: none;
  }
  /* Grid tracks are minmax(0, 1fr): the SVG's intrinsic width (1080 or 360) must never widen a track. */
  .ov-narrow {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    justify-items: center;
  }
  @media (min-width: 64rem) {
    .ov-wide {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .ov-narrow {
      display: none;
    }
  }
  .ov-card {
    min-width: 0;
    width: 100%;
    max-width: 26rem;
    border: 1px solid var(--c-line);
    border-radius: 0.875rem;
    overflow: hidden;
    line-height: 0;
  }
  .ov-wide .ov-card {
    max-width: none;
  }
  .ov-card :global(svg) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }
  code {
    font-size: 0.85em;
  }
</style>
