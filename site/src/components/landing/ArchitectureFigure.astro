---
// Hero figure: two overview diagrams, A (memory) and B (context management), drawn by
// overview-diagrams.mjs with the site's colour tokens. Wide layouts from lg up; below that the
// narrow layouts sit side by side (md) or stacked (phone). Docs use the same source as static SVGs.
import { withBase } from '../../lib/url';
import { CSS_PALETTE, contextDiagram, memoryDiagram } from './overview-diagrams.mjs';

const wide = [memoryDiagram(CSS_PALETTE, 'wide', 'hero-mem-w'), contextDiagram(CSS_PALETTE, 'wide', 'hero-ctx-w')];
const narrow = [memoryDiagram(CSS_PALETTE, 'narrow', 'hero-mem-n'), contextDiagram(CSS_PALETTE, 'narrow', 'hero-ctx-n')];
---
<figure class="ov not-prose" aria-labelledby="ov-caption">
  <div class="ov-wide">
    {wide.map((svg) => <div class="ov-card" set:html={svg} />)}
  </div>
  <div class="ov-narrow">
    {narrow.map((svg) => <div class="ov-card" set:html={svg} />)}
  </div>
  <figcaption id="ov-caption" class="mt-3 text-sm leading-relaxed text-muted">
    OpenMem parts are tinted. A: the indexer feeds one provider; agents read and write it through OpenMem's <code>memory_*</code> tools and session hooks.
    B: past the limit the context proxy moves older turns to a local store instead of asking a model for a summary.{' '}
    <a class="font-semibold text-source underline underline-offset-4" href={withBase('docs/architecture/')}>Full architecture</a> ·
    <a class="font-semibold text-source underline underline-offset-4" href={withBase('docs/context-management/')}>Context management</a> ·
    <a class="font-semibold text-source underline underline-offset-4" href={withBase('docs/provider-status/')}>Provider status</a>
  </figcaption>
</figure>

<style>
  .ov-wide {
    display: none;
  }
  .ov-narrow {
    display: grid;
    gap: 1rem;
    justify-items: center;
  }
  @media (min-width: 48rem) {
    .ov-narrow {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  @media (min-width: 64rem) {
    .ov-wide {
      display: grid;
      gap: 1rem;
    }
    .ov-narrow {
      display: none;
    }
  }
  .ov-card {
    width: 100%;
    max-width: 26rem;
    border: 1px solid var(--c-line);
    border-radius: 0.875rem;
    overflow: hidden;
    line-height: 0;
  }
  .ov-wide .ov-card {
    max-width: none;
  }
  .ov-card :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  code {
    font-size: 0.85em;
  }
</style>
