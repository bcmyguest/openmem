---
import Landing from '../layouts/Landing.astro';
import ArchitectureFigure from '../components/landing/ArchitectureFigure.astro';
import SmartCompactionFigure from '../components/landing/SmartCompactionFigure.astro';
import BenchRace from '../components/landing/BenchRace.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import CodeBlock from '../components/ui/CodeBlock.astro';
import { features, next, providers, security, site, STATUS_LABEL, steps, works } from '../lib/content';
import { withBase } from '../lib/url';
import bench from '../data/contextbench.json';
import { wallTimeSentence } from '../lib/bench-text.mjs';

const supportedNames = providers.filter((p) => p.status === 'supported').map((p) => p.label).join(', ');
const experimentalNames = providers.filter((p) => p.status === 'experimental').map((p) => p.label).join(', ');
const title = `${site.name}: ${site.tagline}`;
const description =
  'Memory and context management for coding agents: smart compaction that keeps every turn searchable, and memory_* tools over Hindsight, mem0, or Cognee.';

// Benchmark tiles, read from contextbench.json (site/scripts/bench/compute-contextbench.py):
// OpenMem against native compaction, mean over the task sizes where native compaction completed a trial.
const BENCH_URL = 'https://github.com/RulinShao/ContextBench';
const vs = bench.vs_native;
const pct = (v: number | null) => (v == null ? '—' : `${Math.round(v * 100)}%`);
const tiles = [
  { label: 'Answer quality', value: vs.score.smart?.toFixed(2), unit: 'score', note: `native compaction ${vs.score.s2?.toFixed(2)}` },
  { label: 'Cost per trial', value: `$${vs.usd.smart?.toFixed(2)}`, unit: 'list price', note: `native compaction $${vs.usd.s2?.toFixed(2)}` },
  {
    label: 'Compaction event',
    value: `${vs.compaction_event_s_median.smart_trim_request_upper_bound.toFixed(1)} s`,
    unit: 'median',
    note: `native summary call ${vs.compaction_event_s_median.s2_summary_call.toFixed(1)} s; ours is the whole request, an upper bound`,
  },
  { label: 'Prompt-cache hits', value: pct(vs.cache_hit.smart), unit: 'of prompt tokens', note: `native compaction ${pct(vs.cache_hit.s2)}` },
];
const seedCounts = Object.values(bench.cells).flatMap((fams) => Object.values(fams).flatMap((sizes) => Object.values(sizes).map((c) => c.n))).filter((n) => n > 0);
const seedRange = `${Math.min(...seedCounts)} to ${Math.max(...seedCounts)} seeds per cell`;

const sourceCommands = `git clone ${site.sourceInstall.clone}
cd ${site.sourceInstall.directory}
${site.sourceInstall.command}`;
const npxCommand = `npx ${site.npm.package}
npx ${site.npm.package} install-coding-agent --yes
npx ${site.npm.package} switch mem0 --yes`;
---
<Landing title={title} description={description}>
  <header class="sticky top-0 z-40 border-b border-line bg-canvas/90 backdrop-blur">
    <nav class="mx-auto flex h-14 max-w-6xl items-center gap-4 px-4 sm:px-6" aria-label="Main">
      <a href={withBase('/')} class="flex items-center gap-2 font-bold">
        <img src={withBase('favicon.svg')} alt="" width="24" height="24" />
        <span class="whitespace-nowrap">{site.name}</span>
      </a>
      <div class="ml-auto flex items-center gap-1 text-sm">
        <a href={withBase('docs/concepts/')} class="rounded-md px-3 py-2 hover:bg-hover">Concepts</a>
        <a href={withBase('docs/getting-started/')} class="hidden rounded-md px-3 py-2 hover:bg-hover sm:inline">Docs</a>
        <a href="#providers" class="hidden rounded-md px-3 py-2 hover:bg-hover sm:inline">Providers</a>
        <a href="#install" class="hidden rounded-md px-3 py-2 hover:bg-hover sm:inline">Install</a>
        <a href={site.repoUrl} class="rounded-md px-3 py-2 hover:bg-hover">Source</a>
        <button type="button" id="theme-toggle" class="rounded-md p-2 hover:bg-hover" aria-label="Toggle dark mode">
          <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
      </div>
    </nav>
  </header>

  <main id="main">
    <section class="mx-auto max-w-6xl px-4 pb-14 pt-10 sm:px-6 lg:pt-14" aria-labelledby="hero-h">
      <div class="max-w-3xl">
        <Badge variant="outline">Smart compaction · pluggable memory</Badge>
        <h1 id="hero-h" class="mt-4 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">{site.tagline}</h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Smart compaction keeps long sessions under the limit with every turn kept and searchable. One <code>memory_*</code> surface, wizard, and indexer over pluggable providers. {supportedNames ? `Supported: ${supportedNames}.` : 'No provider is supported yet.'}{experimentalNames ? ` Experimental: ${experimentalNames}.` : ''}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={withBase('docs/concepts/')} size="lg">Concepts</Button>
          <Button href="#install" variant="outline" size="lg">Install</Button>
          <Button href={withBase('docs/getting-started/')} variant="outline" size="lg">Quickstart</Button>
        </div>
      </div>
      <div class="mt-10">
        <ArchitectureFigure />
      </div>
    </section>

    <section class="border-y border-line bg-panel py-16" aria-labelledby="features-h">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 id="features-h" class="text-3xl font-bold tracking-tight">What it does</h2>
        <p class="mt-3 max-w-2xl text-muted">Indexer, wizard, smoke tests, and MCP registration. Models and memory semantics stay with the provider you chose.</p>
        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((f) => (
            <Card as="li" class="bg-panel-raised">
              <h3 class="flex flex-wrap items-center gap-2 font-semibold">
                {f.title}
                {f.tag && <Badge variant="inferred">{f.tag}</Badge>}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{f.body}</p>
            </Card>
          ))}
        </ul>
      </div>
    </section>

    <section class="py-16" aria-labelledby="compact-h">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="grid items-center gap-8 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-5">
            <p class="text-sm font-semibold uppercase tracking-wider text-source">Context management</p>
            <h2 id="compact-h" class="mt-2 text-3xl font-bold tracking-tight">Smart compaction</h2>
            <p class="mt-3 text-muted">Long sessions keep going without a slow LLM summary. Older turns move to a local store; a pointer and bounded recall take their place; the agent searches the store when it needs a detail back.</p>
            <p class="mt-4 text-sm"><a class="font-semibold text-source underline underline-offset-4" href={withBase('docs/context-management/')}>Context management</a> · <a class="font-semibold text-source underline underline-offset-4" href={withBase('docs/context-proxy/')}>Context proxy</a> · <a class="font-semibold text-source underline underline-offset-4" href={withBase('docs/compatibility/')}>Which agents support it</a></p>
          </div>
          <div class="min-w-0 lg:col-span-7">
            <SmartCompactionFigure />
          </div>
        </div>

        <ul class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4" aria-label="Benchmark: OpenMem against native compaction">
          {tiles.map((t) => (
            <li class="min-w-0 rounded-xl border border-line bg-panel p-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-muted">{t.label}</p>
              <p class="mt-1 flex flex-wrap items-baseline gap-x-1.5"><span class="text-2xl font-bold tracking-tight text-source sm:text-3xl">{t.value}</span><span class="text-xs text-muted">{t.unit}</span></p>
              <p class="mt-1 text-xs leading-relaxed text-muted">{t.note}</p>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs leading-relaxed text-muted">OpenMem against Claude Code's native compaction on <a class="font-semibold text-source underline underline-offset-4" href={BENCH_URL}>ContextBench</a> (synthetic tasks), mean over the {vs.cells.length} task sizes where native compaction completed a trial; Claude Haiku 5.5, {seedRange}. {wallTimeSentence(vs)} <a class="font-semibold text-source underline underline-offset-4" href={withBase('docs/context-management/#benchmarks')}>Benchmarks and caveats</a></p>

        <div class="mt-8">
          <BenchRace />
        </div>
      </div>
    </section>

    <section class="py-16" aria-labelledby="how-h">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 id="how-h" class="text-3xl font-bold tracking-tight">How a run goes</h2>
        <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {steps.map((s) => (
            <li class="rounded-xl border border-line bg-panel p-5">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-soft text-sm font-bold text-source" aria-hidden="true">{s.n}</span>
              <h3 class="mt-3 font-semibold">{s.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{s.body}</p>
            </li>
          ))}
        </ol>
        <p class="mt-6 text-sm"><a class="font-semibold text-source underline underline-offset-4" href={withBase('docs/architecture/')}>Architecture: indexing, MCP, and how memory updates</a></p>
      </div>
    </section>

    <section id="providers" class="border-y border-line bg-panel py-16" aria-labelledby="providers-h">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 id="providers-h" class="text-3xl font-bold tracking-tight">Providers</h2>
        <p class="mt-3 max-w-2xl text-muted">
          Status and ports come from <code>providers/*/manifest.json</code> at build time. Supported means the manifest says production-ready.
        </p>
        <div class="mt-8 overflow-x-auto rounded-xl border border-line" role="region" aria-labelledby="providers-h" tabindex="0">
          <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
            <caption class="sr-only">Memory providers with status, self-host story, and native documentation</caption>
            <thead class="bg-panel-raised">
              <tr>
                <th scope="col" class="px-4 py-3 font-semibold">Provider</th>
                <th scope="col" class="px-4 py-3 font-semibold">Id</th>
                <th scope="col" class="px-4 py-3 font-semibold">Status</th>
                <th scope="col" class="px-4 py-3 font-semibold">Self-host</th>
                <th scope="col" class="px-4 py-3 font-semibold">Native docs</th>
              </tr>
            </thead>
            <tbody>
              {providers.map((p) => (
                <tr class="border-t border-line align-top">
                  <th scope="row" class="px-4 py-3 font-semibold">{p.label}</th>
                  <td class="px-4 py-3"><code>{p.id}</code></td>
                  <td class="px-4 py-3"><Badge variant={p.status}>{STATUS_LABEL[p.status]}</Badge></td>
                  <td class="px-4 py-3 text-muted">
                    {p.selfHost}
                    {p.notes && <span class="mt-1 block text-xs">{p.notes}</span>}
                  </td>
                  <td class="px-4 py-3">
                    {p.nativeDocs ? <a class="font-semibold text-source underline underline-offset-4" href={p.nativeDocs}>{new URL(p.nativeDocs).host}</a> : <span class="text-muted">none listed</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-sm"><a class="font-semibold text-source underline underline-offset-4" href={withBase('docs/provider-status/')}>Per-provider details</a></p>
      </div>
    </section>

    <section id="next" class="py-16" aria-labelledby="next-h">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 id="next-h" class="text-3xl font-bold tracking-tight">Works today. Up next.</h2>
        <p class="mt-3 max-w-2xl text-muted">Shipped features and manifest-driven gaps. No dates.</p>
        <div class="mt-10 grid gap-4 md:grid-cols-2">
          <Card class="bg-panel-raised">
            <h3 class="font-semibold">Works today</h3>
            <ul class="mt-3 space-y-2 text-sm">
              {works.map((w) => <li class="flex gap-2"><span class="text-ok" aria-hidden="true">✓</span><span>{w}</span></li>)}
            </ul>
          </Card>
          <Card class="bg-panel-raised">
            <h3 class="font-semibold">Up next</h3>
            <ul class="mt-3 space-y-2 text-sm">
              {next.map((n) => <li class="flex gap-2"><span class="text-warning" aria-hidden="true">→</span><span>{n}</span></li>)}
            </ul>
          </Card>
        </div>
      </div>
    </section>

    <section id="install" class="border-y border-line bg-panel py-16" aria-labelledby="install-h">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 id="install-h" class="text-3xl font-bold tracking-tight">Install</h2>
        <p class="mt-3 max-w-2xl text-muted">
          You need Docker with Compose v2, Node.js 20.12 or newer, and a model server for the provider you pick (for Hindsight: lemond, Ollama, or an OpenAI-compatible endpoint).
        </p>
        <div class="mt-8 grid gap-4 lg:grid-cols-2">
          <Card class="min-w-0 bg-panel-raised">
            <h3 class="flex flex-wrap items-center gap-2 font-semibold">
              With npx
              {site.npm.published ? <Badge variant="supported">Published</Badge> : <Badge variant="inferred">After first npm release</Badge>}
            </h3>
            {site.npm.published ? (
              <p class="mt-2 text-sm leading-relaxed text-muted">Day-0 and day-2 commands. Run the wizard first; <code>install-coding-agent</code> then registers the unified <code>memory_*</code> MCP and session hooks against that stack.</p>
            ) : (
              <p class="mt-2 text-sm leading-relaxed text-muted">
                Command shape you will use after publish. Until then, clone and run <code>npm run setup</code>; other subcommands run as <code>node cli/openmem.mjs &lt;command&gt;</code>.
              </p>
            )}
            <div class="mt-4"><CodeBlock code={npxCommand} label="npx @bcmyguest/openmem commands" copy={site.npm.published} /></div>
          </Card>
          <Card class="min-w-0 bg-panel-raised">
            <h3 class="flex flex-wrap items-center gap-2 font-semibold">
              From source
              <Badge variant="supported">Works today</Badge>
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              Clone and run <code>npm run setup</code>; <code>node cli/openmem.mjs</code> runs the same CLI. Add <code>--dry-run</code> first to see what setup would do without writing anything.
            </p>
            <div class="mt-4"><CodeBlock code={sourceCommands} label="Clone and run the wizard" /></div>
          </Card>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={withBase('docs/getting-started/')}>Quickstart</Button>
          <Button href={withBase('docs/architecture/')} variant="outline">Architecture</Button>
        </div>
      </div>
    </section>

    <section id="security" class="py-16" aria-labelledby="security-h">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 id="security-h" class="text-3xl font-bold tracking-tight">Security notes</h2>
        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {security.map((s) => (
            <Card as="li">
              <h3 class="font-semibold">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{s.body}</p>
            </Card>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="border-t border-line py-10 text-sm text-muted">
    <div class="mx-auto flex max-w-6xl flex-wrap gap-x-6 gap-y-2 px-4 sm:px-6">
      <span>{site.name}</span>
      <a class="underline-offset-4 hover:text-ink hover:underline" href={withBase('docs/concepts/')}>Concepts</a>
      <a class="underline-offset-4 hover:text-ink hover:underline" href={withBase('docs/getting-started/')}>Docs</a>
      <a class="underline-offset-4 hover:text-ink hover:underline" href={withBase('docs/provider-status/')}>Provider status</a>
      <a class="underline-offset-4 hover:text-ink hover:underline" href={withBase('llms.txt')}>llms.txt</a>
      <a class="underline-offset-4 hover:text-ink hover:underline" href={site.repoUrl}>Source</a>
    </div>
  </footer>
</Landing>
