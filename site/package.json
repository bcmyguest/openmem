{
  "name": "openmem-site",
  "version": "0.0.0",
  "description": "Static site for openmem (Astro + Starlight).",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "theme": "node scripts/gen-theme.mjs",
    "dev": "node scripts/sync.mjs && node scripts/gen-theme.mjs && astro dev",
    "build": "node scripts/sync.mjs && node scripts/gen-theme.mjs && astro build && node scripts/check-privacy.mjs dist && node scripts/check-links.mjs dist",
    "render-diagrams": "node scripts/render-diagrams.mjs",
    "check:privacy": "node scripts/check-privacy.mjs dist",
    "check:sources": "node scripts/check-privacy.mjs --sources-report",
    "check:links": "node scripts/check-links.mjs dist",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.6",
    "@fontsource/dm-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.57.2",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24"
  }
}
